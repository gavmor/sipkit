{
  "name": "@gavmor/sipkit-core",
  "version": "0.2.0",
  "description": "Thin TypeScript orchestration shell over @gavmor/sipkit-wasm for SIPmath 3.1 models: Zod validation, batch evaluation, Welford summaries",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavmor/sipkit.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build && cp ../../LICENSE ."
  },
  "devDependencies": {
    "@gavmor/sipkit-wasm": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
