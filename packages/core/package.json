{
  "name": "@gavmor/sipkit-core",
  "version": "0.1.0",
  "description": "Pure-TypeScript HDR 2.0 PRNG and Metalog quantile functions for the SIPmath 3.1 Standard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavmor/sipkit.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build && cp ../../LICENSE ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
